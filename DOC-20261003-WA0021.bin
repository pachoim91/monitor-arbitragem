services:
  - type: worker
    name: crypto-arbitrage-monitor
    runtime: python
    buildCommand: pip install -r requirements.txt
    startCommand: python main.py
    envVars:
      - key: TELEGRAM_TOKEN
        sync: false
      - key: TELEGRAM_CHAT_ID
        value: "1096617673"
      - key: CAPITAL_USDT
        value: "350"
      - key: MIN_NET_SPREAD
        value: "0.005"
      - key: FEE_BUY
        value: "0.001"
      - key: FEE_SELL
        value: "0.001"
      - key: SAFETY_MARGIN
        value: "0.001"
      - key: POLL_SECONDS
        value: "8"
